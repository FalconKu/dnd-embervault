{
  "schema_version": 1,
  "content_schema_version": 2,
  "locale_schema_version": 1,
  "default_locale": "zh-CN",
  "supported_locales": [
    "zh-CN"
  ],
  "id": "dnd-embervault",
  "name": "余烬金库",
  "version": "1.0.1",
  "description": "D&D 2024 中文原创短冒险：矿主封了矿，说是有瓦斯；封矿的工人一个都没回来。3 章 15 节点 4 结局，约 3 小时，3–5 人，含一场可自动结算的遭遇。",
  "plugin_type": "content-pack",
  "content_profile": "adventure-module",
  "content_delivery_mode": "catalog",
  "license": "CC-BY-NC-4.0",
  "config_schema": "config.schema.json",
  "adventure_packages": [
    "adventures/embervault"
  ],
  "capabilities": [
    "content.world"
  ],
  "permissions": [
    "content.read"
  ],
  "contributes": {
    "world_templates": [
      "content/worlds/*.json"
    ],
    "lorebooks": [
      "content/lorebooks/*.json"
    ],
    "map_definitions": [
      "maps/definitions/*.json"
    ],
    "map_locations": [
      "maps/locations/*.json"
    ]
  },
  "docs": "README.md"
}
